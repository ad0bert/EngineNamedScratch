<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ad0bert</groupId>
    <artifactId>engine-named-scratch-parent</artifactId>
    <version>0.8.2-SNAPSHOT</version>
  </parent>

  <artifactId>engine-named-scratch-demo</artifactId>
  <name>EngineNamedScratch demo</name>
  <description>The demo game: shows the engine's features and is the CI smoke test.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <dist.directory>${project.build.directory}/dist</dist.directory>
    <!-- for -Pjpackage: app-image (a folder), or an installer type such as deb, rpm, dmg, pkg, msi, exe -->
    <jpackage.type>app-image</jpackage.type>
    <!-- jpackage wants a plain numeric version -->
    <jpackage.version>1.0.0</jpackage.version>
    <!-- the JDK modules the bundled runtime keeps (jlink); everything else is left out to keep the download small -->
    <jpackage.modules>java.base,java.desktop,java.logging,java.management,java.naming,java.xml,jdk.unsupported</jpackage.modules>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.ad0bert</groupId>
      <artifactId>engine-named-scratch</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>demo</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- text files with ${project.version} and the like; kept apart so binary assets are never filtered -->
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <!-- target/dist/demo.jar runs with `java -jar` and finds its dependencies in target/dist/lib -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <outputDirectory>${dist.directory}</outputDirectory>
          <archive>
            <manifest>
              <mainClass>game.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
            <manifestEntries>
              <!-- JOGL, JOAL and JInput load native libraries -->
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${dist.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn package -Pjpackage: a self-contained application with its own Java runtime in target/jpackage (no Java needed
      on the player's machine). jpackage builds for the system it runs on; build on each OS for each platform.
    -->
    <profile>
      <id>jpackage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.1</version>
            <executions>
              <execution>
                <id>jpackage</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.home}/bin/jpackage</executable>
                  <arguments>
                    <argument>--type</argument>
                    <argument>${jpackage.type}</argument>
                    <argument>--name</argument>
                    <argument>EngineNamedScratch</argument>
                    <argument>--app-version</argument>
                    <argument>${jpackage.version}</argument>
                    <argument>--vendor</argument>
                    <argument>ad0bert</argument>
                    <argument>--input</argument>
                    <argument>${dist.directory}</argument>
                    <argument>--main-jar</argument>
                    <argument>demo.jar</argument>
                    <argument>--main-class</argument>
                    <argument>game.Main</argument>
                    <!-- what jdeps finds, plus java.xml and java.management for logging configuration -->
                    <argument>--add-modules</argument>
                    <argument>${jpackage.modules}</argument>
                    <argument>--java-options</argument>
                    <argument>--enable-native-access=ALL-UNNAMED</argument>
                    <argument>--dest</argument>
                    <argument>${project.build.directory}/jpackage</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
